/* Token Radar - A refined dashboard for discovering pre-token protocols worth farming.
   Design system: a cohesive palette, fluid spacing, professional typography, and purposeful motion. */
:root {
  /* Core palette - carefully chosen for readability in both light and dark modes */
  --canvas: #f4f6f5;
  --surface: #ffffff;
  --surface-elevated: #ffffff;
  --ink: #1a1f1c;
  --ink-soft: #3d4540;
  --muted: #6b7870;
  --muted-light: #96a29a;
  --border: #dce4de;
  --border-strong: #c4d0c8;
  --accent: #0d6e52;
  --accent-soft: #e6f3ee;
  --accent-strong: #084d35;
  --negative: #b83a2e;
  --negative-soft: #fdeae8;
  --positive: #0d6e52;
  --positive-soft: #e6f3ee;
  --warning: #b57300;
  --warning-soft: #fff8e6;

  /* Radius system */
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-pill: 999px;

  /* Typography */
  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, "SF Mono", "Monaco", "Inconsolata", "Fira Mono", "Droid Sans Mono", monospace;
  --font-display: "Syne", var(--font-sans);

  /* Spacing scale - fluid, proportional */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
  --space-8: 64px;

  /* Type scale */
  --text-xs: 11px;
  --text-sm: 13px;
  --text-base: 15px;
  --text-lg: 17px;
  --text-xl: 20px;
  --text-2xl: 24px;
  --text-3xl: 30px;
  --text-4xl: 38px;

  /* Line heights */
  --leading-tight: 1.15;
  --leading-snug: 1.3;
  --leading-normal: 1.5;
  --leading-relaxed: 1.65;

  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(26, 31, 28, 0.04);
  --shadow-md: 0 4px 12px rgba(26, 31, 28, 0.06);
  --shadow-lg: 0 12px 32px rgba(26, 31, 28, 0.08);
  --shadow-xl: 0 24px 48px rgba(26, 31, 28, 0.1);

  /* Transitions */
  --ease-out: cubic-bezier(0, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --duration-fast: 120ms;
  --duration-normal: 200ms;
  --duration-slow: 300ms;

  /* Z-index layers */
  --z-base: 1;
  --z-sticky: 10;
  --z-dropdown: 20;
  --z-modal: 30;
  --z-toast: 40;
}

/* Dark mode - automatically applied, carefully tuned */
@media (prefers-color-scheme: dark) {
  :root {
    --canvas: #141816;
    --surface: #1a1f1c;
    --surface-elevated: #202723;
    --ink: #f0f4f1;
    --ink-soft: #c8d4cb;
    --muted: #8a9890;
    --muted-light: #6b7870;
    --border: #2d3731;
    --border-strong: #3d4a42;
    --accent: #34d399;
    --accent-soft: #064e37;
    --accent-strong: #6ee7b7;
    --negative: #f87171;
    --negative-soft: #451a1a;
    --positive: #34d399;
    --positive-soft: #064e37;
    --warning: #fbbf24;
    --warning-soft: #453506;

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.5);
    --shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.6);
  }
}

/* Reset & base */
*, *::before, *::after { box-sizing: border-box; }
html {
  color-scheme: light dark;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
body {
  margin: 0;
  background: var(--canvas);
  color: var(--ink);
  font: 400 var(--text-base)/var(--leading-normal) var(--font-sans);
  text-wrap: pretty;
  min-height: 100vh;
}
h1, h2, h3, h4, h5, h6 {
  margin: 0;
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: -0.02em;
  text-wrap: balance;
  color: var(--ink);
}
h1 { font-size: var(--text-3xl); line-height: var(--leading-tight); }
h2 { font-size: var(--text-2xl); line-height: var(--leading-snug); }
h3 { font-size: var(--text-xl); line-height: var(--leading-snug); }
h4 { font-size: var(--text-lg); line-height: var(--leading-snug); }
p { margin: 0; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; border: none; background: none; }
img { max-width: 100%; height: auto; display: block; }

/* Focus & accessibility */
.skip {
  position: absolute; left: -9999px; top: 0; z-index: var(--z-toast);
  padding: var(--space-2) var(--space-4);
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-sm); font-weight: 500;
}
.skip:focus { left: var(--space-4); top: var(--space-4); }
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Layout shell */
.shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--space-6) var(--space-7) var(--space-8);
}

/* Header / Top bar */
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}
.brand { display: flex; align-items: center; gap: var(--space-3); }
.brand-mark {
  width: 32px; height: 32px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
  display: flex; align-items: center; justify-content: center;
  color: var(--surface); font-weight: 700; font-size: var(--text-lg);
  box-shadow: var(--shadow-md);
}
.brand-name { font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.02em; color: var(--muted); }
.top-meta { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: flex-end; color: var(--muted); font-size: var(--text-sm); }
.top-meta span { white-space: nowrap; }

/* Lede section */
.lede {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.6fr);
  gap: var(--space-7);
  padding: var(--space-6) 0 var(--space-5);
  align-items: start;
}
.lede h1 { margin-bottom: var(--space-2); }
.lede p { color: var(--muted); max-width: 65ch; font-size: var(--text-base); line-height: var(--leading-relaxed); }
.facts {
  display: grid;
  gap: var(--space-3);
  align-content: start;
  border-left: 2px solid var(--border);
  padding-left: var(--space-5);
}
.fact { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
.fact b { font-family: var(--font-mono); font-size: var(--text-base); font-weight: 600; tabular-nums: true; }
.fact span { color: var(--muted); font-size: var(--text-sm); }

/* Controls: search, filter, tabs */
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  gap: var(--space-4);
  padding: var(--space-4) 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--space-5);
}
.field { display: grid; gap: var(--space-1); flex: 1; min-width: 200px; }
.field label { color: var(--muted); font-size: var(--text-xs); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
.field input, .field select {
  min-height: 44px;
  padding: 0 var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface);
  transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  width: 100%;
}
.field input:focus, .field select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
.field input { min-width: 280px; }
.tabs { display: flex; gap: var(--space-1); padding: 4px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
.tabs button {
  min-height: 36px;
  padding: 0 var(--space-4);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--muted);
  font-weight: 500;
  font-size: var(--text-sm);
  transition: all var(--duration-fast) var(--ease-out);
}
.tabs button[aria-pressed="true"] {
  background: var(--ink);
  color: var(--surface);
  box-shadow: var(--shadow-sm);
}
.count { margin-left: auto; color: var(--muted); font-size: var(--text-sm); align-self: center; white-space: nowrap; }

/* Panels & cards */
.panel {
  background: var(--surface-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.panel + .panel { margin-top: var(--space-5); }

/* Tables */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
th, td { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); text-align: left; vertical-align: middle; }
th {
  color: var(--muted);
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
  background: var(--surface);
  position: sticky; top: 0; z-index: var(--z-sticky);
}
th button { display: inline-flex; align-items: center; gap: var(--space-1); border: 0; background: none; padding: 0; color: inherit; font: inherit; }
th button:hover { color: var(--ink); }
tbody tr { cursor: pointer; transition: background var(--duration-fast) var(--ease-out); }
tbody tr:hover { background: var(--accent-soft); }
tbody tr[data-selected="true"] {
  background: color-mix(in srgb, var(--accent) 10%, var(--surface-elevated));
  box-shadow: inset 3px 0 0 var(--accent);
}
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; font-size: var(--text-sm); }
.name { display: grid; gap: 2px; }
.name b { font-weight: 600; font-size: var(--text-sm); }
.sub { color: var(--muted); font-size: var(--text-xs); }
.pos { color: var(--positive); font-weight: 500; }
.neg { color: var(--negative); font-weight: 500; }

/* Implied value bar */
.implied { display: flex; align-items: center; gap: var(--space-2); min-width: 180px; }
.bar {
  flex: 1; max-width: 160px; min-width: 80px; height: 8px;
  border-radius: var(--radius-pill);
  background: color-mix(in srgb, var(--border) 50%, var(--surface));
  overflow: hidden;
}
.bar i { display: block; height: 100%; border-radius: var(--radius-pill); background: linear-gradient(90deg, var(--accent) 0%, var(--accent-strong) 100%); transition: width var(--duration-normal) var(--ease-out); }
.implied .num { white-space: nowrap; flex-shrink: 0; }

/* Status badge */
.status { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: var(--text-xs); font-weight: 500; white-space: nowrap; }
.status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }

/* Caption */
caption { text-align: left; padding: var(--space-2) var(--space-4); color: var(--muted); font-size: var(--text-xs); font-weight: 500; background: var(--surface); border-bottom: 1px solid var(--border); }

/* Empty state */
.empty { padding: var(--space-8) var(--space-5); text-align: center; display: grid; gap: var(--space-3); justify-items: center; }
.empty h2 { font-size: var(--text-xl); font-weight: 500; }
.empty p { color: var(--muted); max-width: 320px; }

/* Buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 40px; padding: 0 var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); font-weight: 500; font-size: var(--text-sm); transition: all var(--duration-fast) var(--ease-out); }
.btn:hover { background: var(--canvas); border-color: var(--border-strong); }
.btn:active { transform: scale(0.98); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--surface); }
.btn.primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); color: var(--surface); }
.btn.ghost { background: transparent; }
.btn.ghost:hover { background: var(--accent-soft); color: var(--accent); }

/* Model panel */
.model-panel { margin-top: var(--space-5); padding: var(--space-6); display: grid; gap: var(--space-4); }
.model-panel h2 { display: flex; align-items: center; gap: var(--space-2); }
.model-panel .sub { color: var(--muted); line-height: var(--leading-relaxed); }
.formula { font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.7; color: var(--muted); overflow-wrap: anywhere; background: var(--canvas); padding: var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border); }
.model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); }
.model-item { display: grid; gap: var(--space-1); }
.model-item label { color: var(--muted); font-size: var(--text-xs); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
.model-item output { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 600; color: var(--ink); }

/* Detail drawer (dialog) */
.detail {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(560px, 94vw); z-index: var(--z-modal);
  background: var(--surface-elevated); border-left: 1px solid var(--border);
  padding: var(--space-6); overflow-y: auto;
  transform: translateX(100%); transition: transform var(--duration-normal) var(--ease-out);
  max-height: 100vh;
}
.detail[open] { transform: translateX(0); }
.detail::backdrop { background: rgba(20, 24, 22, 0.4); backdrop-filter: blur(4px); }
.detail-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); padding-bottom: var(--space-4); border-bottom: 1px solid var(--border); }
.detail-head > div { min-width: 0; }
.detail-head .brand-name { margin-top: 2px; }
.detail-head .sub { overflow-wrap: anywhere; margin-top: var(--space-1); }
.close-btn { flex: none; min-width: 40px; min-height: 40px; padding: 0 var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); color: var(--muted); font-size: var(--text-sm); font-weight: 500; transition: all var(--duration-fast) var(--ease-out); }
.close-btn:hover { background: var(--accent-soft); color: var(--accent); border-color: var(--accent); }
.detail h2 { margin-top: var(--space-1); }
.detail-section { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--border); }
.detail-section h3 { margin-bottom: var(--space-3); display: flex; align-items: center; gap: var(--space-2); }
.equation { display: grid; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--text-sm); }
.equation div { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) 0; }
.equation div:not(:last-child) { border-bottom: 1px solid var(--border); }
.equation span { color: var(--muted); }
.equation b { font-weight: 600; }

/* Farm steps */
.steps { margin: 0; padding-left: var(--space-5); display: grid; gap: var(--space-3); counter-reset: step; }
.steps li { position: relative; padding-left: var(--space-3); list-style: none; line-height: var(--leading-relaxed); }
.steps li::before { counter-increment: step; content: counter(step); position: absolute; left: -1.5rem; top: 0; width: 1.25rem; height: 1.25rem; border-radius: 50%; background: var(--accent); color: var(--surface); font-size: var(--text-xs); font-weight: 700; font-family: var(--font-mono); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.steps b { display: block; font-weight: 500; margin-bottom: 2px; }
.cost { color: var(--muted); font-size: var(--text-xs); font-family: var(--font-mono); }

/* Screenshots gallery (for the index page footer) */
.gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); margin-top: var(--space-7); }
.gallery-item { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: var(--surface); box-shadow: var(--shadow-md); }
.gallery-item img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }

/* Footer */
.footer { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--border); color: var(--muted); font-size: var(--text-sm); text-align: center; }
.footer a { color: var(--accent); }
.footer a:hover { text-decoration: underline; }

/* Responsive */
@media (max-width: 1024px) {
  .lede { grid-template-columns: 1fr; gap: var(--space-5); }
  .facts { border-left: 0; border-top: 1px solid var(--border); padding-left: 0; padding-top: var(--space-4); }
  .field input { min-width: 0; width: 100%; }
  .detail { width: 100vw; max-width: 100vw; border-radius: 0; }
}
@media (max-width: 640px) {
  .shell { padding: var(--space-4); }
  .top { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .top-meta { justify-content: flex-start; width: 100%; }
  .controls { flex-direction: column; align-items: stretch; }
  .field { min-width: 0; }
  .field input { width: 100%; }
  .count { margin-left: 0; }
  .implied .bar { max-width: 100px; }
}

/* Print styles */
@media print {
  .controls, .detail, .skip { display: none !important; }
  .panel { break-inside: avoid; }
  tbody tr:hover { background: none; }
}